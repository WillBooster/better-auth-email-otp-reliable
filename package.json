{
  "name": "better-auth-email-otp-reliable-repository",
  "version": "0.0.0-semantically-released",
  "private": true,
  "description": "A reliable email OTP plugin for Better Auth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/better-auth-email-otp-reliable.git"
  },
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter better-auth-email-otp-reliable build",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@willbooster/wb": "22.1.4",
    "better-auth": "1.7.2",
    "build-ts": "21.0.12",
    "vitest": "4.1.11"
  }
}
